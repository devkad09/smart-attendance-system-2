{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./artifacts/**\" run dev",
    "preinstall": "node -e \"if(!process.env.VERCEL && !process.env.CI && !process.env.npm_config_user_agent?.includes('pnpm')) { console.warn('Note: pnpm is recommended'); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "vercel-build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "@esbuild/darwin-x64": "^0.28.1",
    "@rollup/rollup-darwin-x64": "^4.62.3",
    "@vercel/node": "^5.9.0",
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
