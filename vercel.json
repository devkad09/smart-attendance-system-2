{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "smart-attendance-system-2",
  "buildCommand": "pnpm run build",
  "outputDirectory": "artifacts/attendance-app/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
